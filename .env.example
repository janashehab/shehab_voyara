# Step 1 does not read environment variables.
# Later steps add these. Do not commit real values.
#
# Runtime connection for src/server/db.ts.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/voyara"
# Owner connection for `npm run db:seed`, `npx prisma migrate status`, and `npx prisma migrate deploy`.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL="http://localhost:3000"
# AI_API_KEY=
# AI_MODEL=
#
# Provider credentials belong to a future sync adapter.
# Do not add an open-web search key. The planner uses the curated catalog.
