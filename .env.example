# Server-only. Do not commit real values. Do not prefix these with NEXT_PUBLIC_.
#
# Runtime connection for src/server/db.ts.
# Use the Supabase transaction pooler. That host is IPv4. Port 6543 cannot run migrations.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Owner connection for `npm run db:seed`, `npx prisma migrate status`, and `npx prisma migrate deploy`.
# Use the Supabase session pooler on port 5432. That host is IPv4.
# Do not use db.PROJECT_REF.supabase.co. That direct host is often IPv6-only.
# Do not put the port 6543 pooler here.
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
#
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL="http://localhost:3000"
#
# The planner has no LLM provider in this step.
# AI_API_KEY=
# AI_MODEL=
#
# Provider credentials belong to a future sync adapter.
# Do not add an open-web search key. The planner uses the curated catalog.
